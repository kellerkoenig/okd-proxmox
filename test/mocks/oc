# oc mock for CLI tests: client version, and every cluster call fails like
# an unreachable API unless MOCK_OC_OK=1.
echo "oc $*" >>"${MOCK_LOG:-/dev/null}"
if [[ "$1 ${2:-}" == "version --client" ]]; then
	echo '{"releaseClientVersion":"4.21.0-okd-scos.11"}'
	exit 0
fi
[[ ${MOCK_OC_OK:-0} == 1 ]] && exit 0
echo "error: the server could not be reached" >&2
exit 1
