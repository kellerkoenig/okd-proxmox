# podman mock: "run ... -v <dir>:/out ..." drops a fake nmstatectl into <dir>.
echo "podman $*" >>"${MOCK_LOG:-/dev/null}"
for a in "$@"; do
	if [[ ${a} == *:/out:Z ]]; then
		out=${a%:/out:Z}
		printf '#!/bin/sh\necho "nmstatectl 2.2.62"\n' >"${out}/nmstatectl"
		chmod +x "${out}/nmstatectl"
	fi
done
echo "nmstate-2.2.62-3.el9.x86_64"
