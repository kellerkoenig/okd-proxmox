# getent mock: "getent ahostsv4 <name>" answers from MOCK_DNS
# ("name=ip" entries, "*.domain=ip" for wildcards) or fails like NXDOMAIN.
name=${2:-}
[[ -n ${MOCK_DNS:-} ]] || exit 2
ip=$(tr ' ' '\n' <<<"${MOCK_DNS}" | awk -F= -v n="${name}" '$1 == n || (substr($1, 1, 2) == "*." && n ~ ("[.]" substr($1, 3) "$")) { print $2; exit }')
[[ -n ${ip} ]] || exit 2
echo "${ip}       STREAM ${name}"
