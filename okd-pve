DIR_FLAG=''
SKIP_PREFLIGHT=0
CREATE_STEPS=14

usage() {
	cat <<EOF
okd-pve ${OKD_PVE_VERSION} - OKD clusters on Proxmox VE (agent-based installer + OpenTofu)

Usage: okd-pve [global flags] <command> [arguments]

Commands:
  init <cluster>                      Create a commented configuration skeleton
  preflight                           Run all checks without changing anything
  create [--skip-preflight]           Build the cluster (resumes where it stopped)
  verify [--wait] [--timeout S]       Check cluster health
  destroy                             Delete VMs, disks, ISOs and state
  node add --role worker|infra --count N [--group G]
  node remove <node> [--drain-timeout 10m] [--force-control-plane]
  node list                           Nodes with VMID, host, IP, MAC and status
  node reconcile                      Re-apply infra labels and taints
  storage install                     Deploy the configured storage backend (CSI)
  hooks list                          Show Post-Install hooks and last results
  hooks run [name | --from name]      Run hooks (all, one, or from one on)
  kubeconfig [--export]               Print the kubeconfig path
  logs [--installer] [--follow]       Show the latest log (--follow moves on to later runs)
  tui                                 Text user interface (whiptail/dialog)
  version                             Show versions

Global flags:
  --dir DIR          Cluster directory (default: ./clusters/<name> or the current dir)
  --config FILE      cluster.yaml to use (default: <dir>/cluster.yaml)
  --hooks-dir DIR    External (private) hooks directory
  --dry-run          Show what would happen, change nothing
  --yes, -y          Answer yes to all questions
  --debug            Verbose output, shell trace into the log file
  --no-color         Disable colors
  --log-file FILE    Log file (default: <dir>/logs/okd-pve-<command>-<time>.log)

Exit codes: 0 ok, 1 error, 2 configuration error, 3 preflight failed, 4 hook failed.
Documentation: README.md and docs/ in ${OKD_PVE_ROOT}
EOF
}

abspath() {
	if [[ $1 == /* ]]; then printf '%s' "$1"; else printf '%s/%s' "${PWD}" "$1"; fi
}

# parse_global_flags <args...>: sets globals, leaves the rest in ARGS.
ARGS=()
parse_global_flags() {
	ARGS=()
	while (($#)); do
		case $1 in
		--dir) DIR_FLAG=${2:?--dir needs a value} && shift 2 ;;
		--dir=*) DIR_FLAG=${1#*=} && shift ;;
		--config) CONFIG_FILE=$(abspath "${2:?--config needs a value}") && shift 2 ;;
		--config=*) CONFIG_FILE=$(abspath "${1#*=}") && shift ;;
		--hooks-dir) HOOKS_DIR_OVERRIDE=$(abspath "${2:?--hooks-dir needs a value}") && shift 2 ;;
		--hooks-dir=*) HOOKS_DIR_OVERRIDE=$(abspath "${1#*=}") && shift ;;
		--dry-run) DRY_RUN=1 && shift ;;
		--yes | -y) ASSUME_YES=1 && shift ;;
		--debug) DEBUG=1 && shift ;;
		--no-color) NO_COLOR=1 && shift ;;
		--log-file) LOG_FILE=$(abspath "${2:?--log-file needs a value}") && shift 2 ;;
		--log-file=*) LOG_FILE=$(abspath "${1#*=}") && shift ;;
		--skip-preflight) SKIP_PREFLIGHT=1 && shift ;;
		-h | --help) ARGS+=(help) && shift ;;
		--) shift && ARGS+=("$@") && break ;;
		*) ARGS+=("$1") && shift ;;
		esac
	done
}

setup_logging() {
	local cmd=$1
	if [[ -z ${LOG_FILE} ]]; then
		mkdir -p "${LOG_DIR}"
		chmod 700 "${LOG_DIR}"
		LOG_FILE=${LOG_DIR}/okd-pve-${cmd}-$(date +%Y%m%d-%H%M%S).log
		# latest.log points to the newest real run, not to "okd-pve logs".
		[[ ${cmd%%-*} == logs ]] || ln -sfn "${LOG_FILE##*/}" "${LOG_DIR}/latest.log"
	else
		mkdir -p "$(dirname "${LOG_FILE}")"
	fi
	: >>"${LOG_FILE}"
	chmod 600 "${LOG_FILE}"
	_log_to_file START "okd-pve ${OKD_PVE_VERSION} ${cmd} (dir ${CLUSTER_DIR}, dry-run=${DRY_RUN})"
}

# setup_debug_trace: shell trace into the log file, through the redaction
# filter. Called after the secrets are registered.
setup_debug_trace() {
	((DEBUG)) || return 0
	exec {OKD_PVE_XTRACE_FD}> >(redact_stream --log "${LOG_FILE}")
	BASH_XTRACEFD=${OKD_PVE_XTRACE_FD}
	PS4='+ ${BASH_SOURCE[0]##*/}:${LINENO} ${FUNCNAME[0]:-main}: '
	set -x
}

# cluster_context_load <command>: cluster dir, logging, configuration.
cluster_context_load() {
	resolve_cluster_dir "${DIR_FLAG}"
	tools_path
	setup_logging "$1"
	config_load
	config_validate
	# Credentials are loaded (if present) before any tracing starts so the
	# token is registered for redaction in every output channel.
	if [[ -f ${PROXMOX_CONF_FILE} || -n ${PROXMOX_VE_API_TOKEN:-} ]]; then
		proxmox_conf_load
	fi
	register_pull_secret
	[[ -f ${AUTH_DIR}/kubeadmin-password ]] && redact_register "$(cat "${AUTH_DIR}/kubeadmin-password")"
	setup_debug_trace
	nodes_json >/dev/null
}

proxmox_require() {
	[[ -n ${PROXMOX_VE_API_TOKEN:-} ]] || proxmox_conf_load
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
	local name=${1:-}
	[[ ${name} =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]] ||
		die "${EXIT_CONFIG}" "init needs a cluster name (lowercase letters, digits, dashes; max 32 chars)." "okd-pve init <name>"
	local dir=${DIR_FLAG:-./clusters/${name}}
	local files=(cluster.yaml install-config.yaml proxmox.conf .gitignore preboot/README.md)
	local f
	for f in "${files[@]}"; do
		[[ -e ${dir}/${f} ]] && die "${EXIT_CONFIG}" "${dir}/${f} already exists; refusing to overwrite." \
			"Use another --dir or remove the file."
	done
	if ((DRY_RUN)); then
		for f in "${files[@]}"; do dry_run_note "would create ${dir}/${f}"; done
		return 0
	fi
	mkdir -p "${dir}/preboot"
	TPL=([NAME]=${name})
	for f in cluster.yaml install-config.yaml proxmox.conf; do
		render_template "${OKD_PVE_ROOT}/templates/init/${f}.tpl" >"${dir}/${f}"
	done
	cp "${OKD_PVE_ROOT}/templates/init/gitignore" "${dir}/.gitignore"
	cp "${OKD_PVE_ROOT}/templates/init/preboot-README.md" "${dir}/preboot/README.md"
	chmod 600 "${dir}/proxmox.conf"
	log_ok "Created cluster configuration in ${dir}"
	log_info "Next steps:"
	log_info "  1. Edit ${dir}/install-config.yaml (base domain, VIPs, machine network)"
	log_info "  2. Edit ${dir}/cluster.yaml (Proxmox nodes, storage, node groups, IPs)"
	log_info "  3. Put the API token into ${dir}/proxmox.conf (docs/proxmox-permissions.md)"
	log_info "  4. okd-pve preflight --dir ${dir}"
}

