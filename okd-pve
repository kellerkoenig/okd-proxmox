	echo "okd-pve needs bash 4.4 or newer (found ${BASH_VERSION})." >&2
	exit 1
fi

_okd_pve_root() {
	local src=${BASH_SOURCE[0]} dir
	while [[ -L ${src} ]]; do
		dir=$(cd -P "$(dirname "${src}")" && pwd)
		src=$(readlink "${src}")
		[[ ${src} == /* ]] || src=${dir}/${src}
	done
	cd -P "$(dirname "${src}")" && pwd
}
OKD_PVE_ROOT=$(_okd_pve_root)
export OKD_PVE_ROOT

