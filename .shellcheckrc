shell=bash
external-sources=true
source-path=SCRIPTDIR
# SC2016: jq/yq programs are single-quoted on purpose.
# SC2119: optional function arguments are common in this code base.
# SC2317: functions called indirectly (oc_wait, traps) look unreachable.
disable=SC2016,SC2119,SC2317
