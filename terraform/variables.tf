variable "cluster_name" {
  description = "Cluster name (install-config.yaml metadata.name)."
  type        = string
}

variable "pool_id" {
  description = "Existing Proxmox resource pool that receives all VMs."
  type        = string
}

variable "vm_storage" {
  description = "Default datastore for boot disks."
  type        = string
}

variable "efi_storage" {
  description = "Datastore for EFI vars disks (only with bios = ovmf)."
  type        = string
}

variable "iso_storage" {
  description = "Datastore that receives the ISO images (content type iso)."
  type        = string
}

variable "iso_storage_shared" {
  description = "True when iso_storage is shared between nodes (upload once)."
  type        = bool
  default     = false
}

variable "bridge" {
  description = "Linux bridge or SDN VNet for the node NICs."
  type        = string
}

variable "vlan_id" {
  description = "VLAN tag for the node NICs, 0 for untagged."
  type        = number
  default     = 0
}

variable "cpu_type" {
  description = "QEMU CPU type. SCOS 10 needs x86-64-v3 or host."
  type        = string
  default     = "host"
}

variable "bios" {
  description = "ovmf (UEFI) or seabios."
  type        = string
  default     = "ovmf"

  validation {
    condition     = contains(["ovmf", "seabios"], var.bios)
    error_message = "bios must be ovmf or seabios."
  }
}

variable "machine" {
  description = "QEMU machine type."
  type        = string
  default     = "q35"
}

variable "guest_agent" {
  description = "Enable the QEMU guest agent (SCOS ships and starts it)."
  type        = bool
  default     = true
}

variable "tags" {
  description = "Set Proxmox tags (okd, okd-pve, cluster, roles). Proxmox checks VM.Config.Options on /vms/<vmid> (not the pool) when tags are set at creation."
  type        = bool
  default     = false
}

variable "ha" {
  description = "Register the VMs as Proxmox HA resources (needs Sys.Audit and Sys.Console on /)."
  type = object({
    enabled      = bool
    max_restart  = number
    max_relocate = number
  })
  default = { enabled = false, max_restart = 1, max_relocate = 1 }
}

variable "upload_timeout" {
  description = "Timeout in seconds for ISO uploads."
  type        = number
  default     = 3600
}

variable "isos" {
  description = "ISO images to upload, keyed by a short name (agent, add-<n>)."
  type = map(object({
    path      = string
    file_name = string
    hosts     = list(string)
  }))
  default = {}
}

variable "nodes" {
  description = "Cluster nodes keyed by hostname. Generated by okd-pve from cluster.yaml."
  type = map(object({
    host        = string
    vmid        = number
    mac         = string
    cpu         = number
    memory_mib  = number
    disk_gib    = number
    boot_serial = string
    roles       = list(string)
    iso         = string
    data_disks = list(object({
      size_gib = number
      storage  = string
      serial   = string
    }))
  }))

  validation {
    condition     = alltrue([for n in values(var.nodes) : length(n.boot_serial) <= 20 && alltrue([for d in n.data_disks : length(d.serial) <= 20])])
    error_message = "Disk serials must not exceed 20 characters (Proxmox limit)."
  }
}
