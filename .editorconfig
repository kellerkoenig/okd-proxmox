root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{*.sh,*.bash,*.bats,okd-pve,*.example}]
indent_style = tab
shell_variant = bash
binary_next_line = true
switch_case_indent = false

[*.{tf,yaml,yml,json,md,jq,tpl,hcl}]
indent_style = space
indent_size = 2
