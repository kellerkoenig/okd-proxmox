#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 The okd-proxmox Authors
#
# EXAMPLE (not run): service account with a read-only ClusterRole for an
# external inventory/CMDB, and a token for it via sa_token.
# Copy into your private hooks directory, rename to 81-inventory-serviceaccount.sh,
# chmod +x and adapt.
#
#   INVENTORY_NAMESPACE   default: okd-pve-inventory
#   INVENTORY_TOKEN_FILE  where to write the token (mode 600); default: print nothing
set -euo pipefail
# shellcheck source=../lib/oclib.sh
source "${OKD_PVE_LIB_DIR:?run via okd-pve hooks run}/oclib.sh"

ns=${INVENTORY_NAMESPACE:-okd-pve-inventory}
oc get namespace "${ns}" >/dev/null 2>&1 || oc create namespace "${ns}" >/dev/null
apply_idempotent - <<YAML
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: okd-pve-inventory-reader
rules:
  - apiGroups: ["", apps, batch, route.openshift.io, config.openshift.io]
    resources: [nodes, namespaces, pods, services, deployments, statefulsets, daemonsets, jobs, cronjobs, routes, clusterversions, infrastructures]
    verbs: [get, list, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: okd-pve-inventory-reader
subjects:
  - kind: ServiceAccount
    name: inventory
    namespace: ${ns}
roleRef:
  kind: ClusterRole
  name: okd-pve-inventory-reader
  apiGroup: rbac.authorization.k8s.io
YAML

# Long-lived token (Secret of type kubernetes.io/service-account-token);
# use "sa_token inventory <ns> --duration 8760h" for an expiring one.
token=$(sa_token inventory "${ns}" --long-lived)
if [[ -n ${INVENTORY_TOKEN_FILE:-} ]]; then
	(umask 077 && printf '%s\n' "${token}" >"${INVENTORY_TOKEN_FILE}")
	echo "Token written to ${INVENTORY_TOKEN_FILE}."
fi
